{
  "description": "Codex-safe lifecycle hooks for Woobin Harness. Claude Code uses claude-hooks.json.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-kickoff-guard.sh\"",
            "timeout": 10,
            "statusMessage": "구현 플랜 크기 점검 중..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/kickoff-guard.sh\"",
            "timeout": 10,
            "statusMessage": "kick-off 진입·이탈 점검 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOST=codex \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-apply-patch-adapter.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/harness-doc-sync-guard.sh\"",
            "timeout": 15,
            "statusMessage": "하네스 문서 동기화 확인 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOST=codex HARNESS_STATE_DIR=\"${PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-warning-ack-guard.sh\"",
            "timeout": 10,
            "statusMessage": "stale-branch 경고 전달 확인 중..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_HOST=codex HARNESS_STATE_DIR=\"${PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stale-branch-guard.sh\"",
            "timeout": 15,
            "statusMessage": "stale-branch 점검 중..."
          }
        ]
      }
    ]
  }
}
